generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  mediaFiles MediaFile[]

  @@map("users")
}

model HomeSetting {
  id              Int      @id @default(autoincrement())
  heroTitle       String?  @map("hero_title")
  heroSubtitle    String?  @map("hero_subtitle")
  profileImage    String?  @map("profile_image")
  backgroundImage String?  @map("background_image")
  ctaText         String?  @map("cta_text")
  ctaUrl          String?  @map("cta_url")
  aboutText       String?  @db.Text @map("about_text")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("home_settings")
}

model Skill {
  id           Int      @id @default(autoincrement())
  name         String
  category     String?
  proficiency  Int      @default(0)
  icon         String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

model PortfolioCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  portfolios  Portfolio[]

  @@map("portfolio_categories")
}

model PortfolioGallery {
  id           Int      @id @default(autoincrement())
  portfolioId  Int      @map("portfolio_id")
  mediaFileId  Int      @map("media_file_id")
  displayOrder Int      @default(0) @map("display_order")
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  mediaFile    MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  @@map("portfolio_gallery")
}

model PortfolioTechnology {
  id             Int      @id @default(autoincrement())
  portfolioId    Int      @map("portfolio_id")
  technologyName String   @map("technology_name")
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("portfolio_technologies")
}

model Portfolio {
  id              Int      @id @default(autoincrement())
  title           String
  shortDescription String? @db.Text @map("short_description")
  fullDescription  String? @db.Text @map("full_description")
  categoryId      Int?     @map("category_id")
  featuredImageId Int?     @map("featured_image_id")
  projectUrl      String?  @map("project_url")
  githubUrl       String?  @map("github_url")
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  isFeatured      Boolean  @default(false) @map("is_featured")
  isPublished     Boolean  @default(true) @map("is_published")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  category        PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage   MediaFile? @relation("PortfolioFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  gallery         PortfolioGallery[]
  technologies    PortfolioTechnology[]

  @@map("portfolio")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model SocialLink {
  id       Int     @id @default(autoincrement())
  platform String
  url      String
  icon     String?
  isActive Boolean @default(true) @map("is_active")

  @@map("social_links")
}

model SiteSetting {
  id                 Int      @id @default(autoincrement())
  siteName           String?  @map("site_name")
  primaryColor       String?  @map("primary_color")
  secondaryColor     String?  @map("secondary_color")
  darkModeEnabled    Boolean  @default(false) @map("dark_mode_enabled")
  instagramEnabled   Boolean  @default(false) @map("instagram_enabled")
  instagramPostLimit Int      @default(6) @map("instagram_post_limit")
  email              String?
  phone              String?
  whatsapp           String?
  linkedinUrl        String?  @map("linkedin_url")
  githubUrl          String?  @map("github_url")
  layoutMode         String   @default("single") @map("layout_mode")
  showSkillProficiency Boolean @default(true) @map("show_skill_proficiency")
  enablePages         Boolean @default(true) @map("enable_pages")
  resumeLayout        String  @default("classic") @map("resume_layout")
  showEducation       Boolean @default(true) @map("show_education")
  showVolunteer       Boolean @default(true) @map("show_volunteer")
  showPublication     Boolean @default(true) @map("show_publication")
  showCourse          Boolean @default(true) @map("show_course")
  showCertification   Boolean @default(true) @map("show_certification")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Education {
  id          Int      @id @default(autoincrement())
  institution String
  degree      String
  field       String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  gpa         String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("education")
}

model Volunteer {
  id          Int      @id @default(autoincrement())
  organization String
  role        String
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("volunteer")
}

model Publication {
  id            Int      @id @default(autoincrement())
  title         String
  publisher     String?
  publishedDate DateTime? @map("published_date")
  url           String?
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("publications")
}

model Course {
  id          Int      @id @default(autoincrement())
  name        String
  provider    String?
  completedDate DateTime? @map("completed_date")
  url         String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("courses")
}

model Certification {
  id              Int      @id @default(autoincrement())
  name            String
  organization    String?
  issuedDate      DateTime? @map("issued_date")
  expirationDate  DateTime? @map("expiration_date")
  credentialUrl   String?  @map("credential_url")
  credentialId    String?  @map("credential_id")
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("certifications")
}

model HomepageTemplate {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  description    String?
  thumbnailImage String?  @map("thumbnail_image")
  previewImage   String?  @map("preview_image")
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  configurations HomepageConfiguration[]

  @@map("homepage_templates")
}

model HomepageConfiguration {
  id                 Int      @id @default(autoincrement())
  homepageTemplateId Int      @map("homepage_template_id")
  configurationJson  String   @db.Text @map("configuration_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  template           HomepageTemplate @relation(fields: [homepageTemplateId], references: [id], onDelete: Cascade)

  @@map("homepage_configurations")
}

model PageTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  description  String?
  previewImage String?  @map("preview_image")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  pages        Page[]

  @@map("page_templates")
}

model Page {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  templateId    Int      @map("template_id")
  seoTitle      String?  @map("seo_title")
  seoDescription String? @map("seo_description")
  isPublished   Boolean  @default(false) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  template      PageTemplate @relation(fields: [templateId], references: [id])
  contents      PageContent[]

  @@map("pages")
}

model PageContent {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  contentJson String   @db.Text @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("page_contents")
}

model MediaFile {
  id               Int      @id @default(autoincrement())
  filename         String
  originalFilename String   @map("original_filename")
  filePath         String   @map("file_path")
  fileSize         Int      @map("file_size")
  mimeType         String   @map("mime_type")
  altText          String?  @map("alt_text")
  uploadedById     Int?     @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at")
  uploader         User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  featuredPortfolios Portfolio[] @relation("PortfolioFeaturedImage")
  galleryEntries   PortfolioGallery[]

  @@map("media_files")
}
